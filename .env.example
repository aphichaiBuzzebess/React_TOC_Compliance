# Optional. By default each user enters their own provider, model and key in the web UI (nothing is stored).
# If set, every request must send this code (x-access-code). Leave empty for an open site.
ACCESS_CODE=

# Optional default AI for people who do not enter a key. Off unless LLM_PROVIDER is set.
# A public production site with no ACCESS_CODE ignores it, so strangers cannot spend your key.
# LLM_PROVIDER=gemini            # anthropic | gemini | openai | deepseek | byteplus
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash  # optional, falls back to the first model in the list
# OPENAI_API_KEY=                # with LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-5             # optional
# DEEPSEEK_API_KEY=              # with LLM_PROVIDER=deepseek (text only: no PDF or images)
# DEEPSEEK_MODEL=deepseek-chat   # optional
# BYTEPLUS_API_KEY=              # with LLM_PROVIDER=byteplus (GLM on BytePlus ModelArk, text only)
# BYTEPLUS_MODEL=glm-5.3-flash   # optional
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# Accounts (optional). Set DATABASE_URL to turn on sign-in, a saved AI key per person and review history.
# Without it the app is stateless as before. Use a Postgres from the Vercel Marketplace (Neon): it sets DATABASE_URL for you.
# DATABASE_URL=
# 32 random bytes, base64. Encrypts the saved AI keys. Generate: openssl rand -base64 32. Keep it only here and in Vercel env.
# KEY_ENCRYPTION_SECRET=
# In account mode ACCESS_CODE is the team code needed to SIGN UP (it is no longer sent with every request).
# Sign-up is closed on Vercel (production and preview) when ACCESS_CODE is empty.
