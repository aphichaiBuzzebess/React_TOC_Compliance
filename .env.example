# Secrets live in Vercel env (or .env.local for `vercel dev`), never in git.
ANTHROPIC_API_KEY=
# Shared code the web UI sends in x-access-code; endpoints refuse to run without it.
ACCESS_CODE=
# Optional
# ANTHROPIC_MODEL=claude-sonnet-5-5

# LLM provider: anthropic (default) or gemini
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
