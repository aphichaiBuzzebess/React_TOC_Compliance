# Optional. By default each user enters their own provider, model and key in the web UI (nothing is stored).
# If set, every request must send this code (x-access-code). Leave empty for an open site.
ACCESS_CODE=

# Optional default AI for people who do not enter a key. Off unless LLM_PROVIDER is set.
# A public production site with no ACCESS_CODE ignores it, so strangers cannot spend your key.
# LLM_PROVIDER=gemini            # anthropic | gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash  # optional, falls back to the first model in the list
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
